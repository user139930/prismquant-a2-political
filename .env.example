# 複製成 .env 後填入自己的設定；不要提交真實 key 與密碼

# 大模型（OpenRouter，OpenAI 相容介面）
PQ_LLM_API_KEY=sk-or-v1-你的key
PQ_LLM_MODEL=deepseek/deepseek-chat
PQ_LLM_BASE_URL=https://openrouter.ai/api/v1

# 服務
PQ_HOST=127.0.0.1
PQ_PORT=8120
# PQ_CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL（與隊友的政治監控後端同一個資料庫）
PQ_DB_HOST=127.0.0.1
PQ_DB_PORT=5432
PQ_DB_NAME=prismquant_political
PQ_DB_USER=prismquant_app
PQ_DB_PASSWORD=你的資料庫密碼
